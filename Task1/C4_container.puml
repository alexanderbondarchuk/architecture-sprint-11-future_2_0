@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(А, "Администратор", "Управляет доступом и ролями")
Person(БП, "Бизнес-пользователь", "Сотрудник головного офиса или доменов")
Person(АН, "Аналитик", "Строит отчеты и дашборды")
Person(ОК, "Оператор клиники", "Работает с медицинскими данными")
Person(ФС, "Финтех-специалист", "Работает с финансовыми сервисами")
Person(СИИ, "Специалист ИИ", "Разрабатывает и использует ML-модели")

System_Boundary(platform, "Платформа данных «Будущее 2.0»") {
    
    ' IAM система
    System_Boundary(iam_system, "IAM система") {
        Container(1, "1. Keycloak Server", "Keycloak", "Аутентификация, авторизация, RBAC")
        ContainerDb(2, "2. Keycloak DB", "PostgreSQL", "Конфигурация RBAC")
    }
    
    ' Портал самообслуживания
    System_Boundary(self_service, "Портал самообслуживания") {
        Container(3, "3. Веб-интерфейс портала", "Next.js", "Конструктор отчетов")
        Container(4, "4. API портала", "Go", "Бэкенд портала")
        Container(5, "5. Семантический слой", ".NET", "Управление метриками")
    }
    
    ' BI слой
    Container(6, "6. BI-платформа", "Power BI + Superset", "Дашборды и аналитика")
    
    ' Платформа данных
    System_Boundary(data_platform, "Платформа данных") {
        Container(7, "7. Оркестрация", "Apache Airflow", "Управление ETL/ELT")
        Container(8, "8. Стрим-обработка", "Apache Spark", "Обработка потоковых данных")
        Container(9, "9. Каталог данных", "DataHub", "Метаданные, lineage")
        Container(10, "10. Контроль качества", "Great Expectations", "Мониторинг качества")
        
        ContainerDb(11, "11. Raw Zone", "MinIO", "Сырые данные Parquet/JSON/AVRO")
        ContainerDb(12, "12. Iceberg Tables", "Apache Iceberg", "Очищенные таблицы")
        ContainerDb(13, "13. Serving Layer", "ClickHouse", "Оптимизированные витрины")
    }
    
    ' Интеграционный слой
    Container(14, "14. API Gateway", "Kong", "Единая точка входа")
    Container(15, "15. Шина событий", "Apache Kafka", "Асинхронная коммуникация")
    Container(16, "16. Адаптер унаследованных систем", ".NET", "Интеграция и миграция")
}

' Бизнес-домены
System_Boundary(domains, "Бизнес-домены") {
    System_Boundary(medical_domain, "Медицинский домен") {
        Container(17, "17. Медицинская система", ".NET", "Управление клиниками и пациентами")
        Container(18, "18. API медицинских сервисов", "Go", "API медицинских данных (без PHI)")
    }
    
    System_Boundary(fintech_domain, "Финтех-домен") {
        Container(19, "19. Финтех-сервисы", "Go", "Банковские операции и платежи")
        Container(20, "20. API финтех-сервисов", "Go", "Финансовые транзакции и отчеты")
        ContainerDb(21, "21. Транзакционная БД", "PostgreSQL", "Финансовые транзакции")
    }
    
    System_Boundary(ai_domain, "ИИ-домен") {
        Container(22, "22. ИИ-сервисы", "Python + .NET", "ML модели для диагностики и аналитики")
        Container(23, "23. API ИИ-сервисов", "Go", "Скоринг и рекомендации")
    }
}

' Унаследованные системы
System_Boundary(legacy, "Унаследованные системы") {
    Container(24, "24. Унаследованный DWH", "SQL Server 2008", "Исторические данные и витрины")
    Container(25, "25. Power BI отчеты", "Power BI", "Существующие отчеты и дашборды")
    Container(26, "26. PowerBuilder UI", "PowerBuilder", "Интерфейсы операторов клиник")
}

' Внешние партнеры
System_Ext(27, "27. Фарма-партнеры", "API/файлы")
System_Ext(28, "28. Производители оборудования", "API/телеметрия")

' Корпоративные системы
System_Ext(29, "29. Корпоративный LDAP/AD", "Active Directory", "Управление пользователями")

' === IAM ИНТЕГРАЦИИ ===
Rel(А, 1, "<b>А→1</b> Управление RBAC", "HTTPS/Admin API")
Rel(БП, 1, "<b>БП→1</b> Аутентификация", "OIDC")
Rel(АН, 1, "<b>АН→1</b> Аутентификация", "OIDC")
Rel(ОК, 1, "<b>ОК→1</b> Аутентификация", "OIDC")
Rel(ФС, 1, "<b>ФС→1</b> Аутентификация", "OIDC")
Rel(СИИ, 1, "<b>СИИ→1</b> Аутентификация", "OIDC")

Rel(1, 29, "<b>1→29</b> Синхронизация пользователей", "LDAP")
Rel(1, 2, "<b>1→2</b> Хранение конфигурации", "PostgreSQL")

' === АУТЕНТИФИКАЦИЯ СЕРВИСОВ ===
Rel(3, 1, "<b>3→1</b> Получение токенов", "OIDC")
Rel(4, 1, "<b>4→1</b> Валидация токенов", "OAuth2")
Rel(14, 1, "<b>14→1</b> Проверка авторизации", "OAuth2")
Rel(6, 1, "<b>6→1</b> Единый вход", "SAML/OIDC")
Rel(18, 1, "<b>18→1</b> Service auth", "OAuth2")
Rel(20, 1, "<b>20→1</b> Service auth", "OAuth2")
Rel(23, 1, "<b>23→1</b> Service auth", "OAuth2")

' === ПОЛЬЗОВАТЕЛЬСКИЕ ВЗАИМОДЕЙСТВИЯ ===
Rel(БП, 3, "<b>БП→3</b> Создание отчетов", "HTTPS")
Rel(АН, 6, "<b>АН→6</b> Аналитика и дашборды", "HTTPS")
Rel(ОК, 26, "<b>ОК→26</b> Работа с мед.данными", "Desktop App")
Rel(ФС, 19, "<b>ФС→19</b> Фин. операции", "HTTPS")
Rel(СИИ, 22, "<b>СИИ→22</b> Разработка ML", "HTTPS/SSH")

' === ВНУТРЕННИЕ СВЯЗИ ПОРТАЛА ===
Rel(3, 4, "<b>3→4</b> API вызовы", "REST/GraphQL")
Rel(4, 5, "<b>4→5</b> Запрос метрик", "gRPC")
Rel(4, 14, "<b>4→14</b> Доступ к данным", "HTTPS")
Rel(5, 13, "<b>5→13</b> Выполнение запросов", "SQL")

' === BI ИНТЕГРАЦИИ ===
Rel(6, 5, "<b>6→5</b> Подключение к метрикам", "SQL")
Rel(6, 13, "<b>6→13</b> Запросы к витринам", "SQL")
Rel(6, 12, "<b>6→12</b> SQL к Iceberg", "JDBC")

' === ПОТОКИ ДАННЫХ ===
Rel(7, 11, "<b>7→11</b> Загрузка сырых данных", "S3 API")
Rel(7, 8, "<b>7→8</b> Оркестрация пайплайнов", "REST")
Rel(8, 12, "<b>8→12</b> Обработка в Iceberg", "Spark")
Rel(7, 12, "<b>7→12</b> Пакетная обработка", "Spark")
Rel(7, 13, "<b>7→13</b> Обновление витрин", "ETL")
Rel(9, 11, "<b>9→11</b> Регистрация данных", "API")
Rel(9, 12, "<b>9→12</b> Управление lineage", "API")
Rel(10, 12, "<b>10→12</b> Валидация качества", "API")

' === ИНТЕГРАЦИЯ ДОМЕНОВ ===
Rel(14, 18, "<b>14→18</b> Мед. API", "REST/gRPC")
Rel(14, 20, "<b>14→20</b> Финтех API", "REST/gRPC")
Rel(14, 23, "<b>14→23</b> ИИ API", "REST/gRPC")

' === СОБЫТИЙНАЯ АРХИТЕКТУРА ===
Rel(17, 15, "<b>17→15</b> Мед. события", "Kafka")
Rel(19, 15, "<b>19→15</b> Фин. события", "Kafka")
Rel(22, 15, "<b>22→15</b> ML события", "Kafka")
Rel(15, 8, "<b>15→8</b> Обработка событий", "Kafka")

' === ИНТЕГРАЦИЯ УНАСЛЕДОВАННЫХ СИСТЕМ ===
Rel(16, 24, "<b>16→24</b> Миграция данных", "ODBC")
Rel(16, 15, "<b>16→15</b> Трансляция событий", "Kafka")
Rel(26, 24, "<b>26→24</b> Операционные данные", "ODBC")
Rel(25, 24, "<b>25→24</b> Существующие отчеты", "ODBC")
Rel(25, 13, "<b>25→13</b> Новые витрины", "ODBC")

' === ВНЕШНИЕ ИНТЕГРАЦИИ ===
Rel(27, 14, "<b>27→14</b> Данные партнеров", "HTTPS")
Rel(28, 15, "<b>28→15</b> Телеметрия", "Kafka")

' === МЕЖДОМЕННЫЕ СВЯЗИ ===
Rel(18, 23, "<b>18→23</b> ML-диагностика", "gRPC")
Rel(20, 18, "<b>20→18</b> Валидация данных", "REST")

' === ИНТЕГРАЦИЯ ИИ-СЕРВИСОВ ===
Rel(22, 12, "<b>22→12</b> Обучение моделей", "Spark")
Rel(22, 13, "<b>22→13</b> Инференс", "SQL")
Rel(8, 22, "<b>8→22</b> Обновление моделей", "REST")

' === DATA ENGINEERING ПОТОКИ ===
Rel(18, 11, "<b>18→11</b> Мед. данные (без PHI)", "Event Streaming")
Rel(20, 11, "<b>20→11</b> Фин. транзакции", "Event Streaming")
Rel(23, 11, "<b>23→11</b> Данные для ML", "Batch")

' === ФИНТЕХ ИНТЕГРАЦИИ ===
Rel(19, 21, "<b>19→21</b> Транзакционные операции", "SQL")
Rel(20, 21, "<b>20→21</b> Доступ к транзакциям", "SQL")
Rel(21, 15, "<b>21→15</b> Публикация фин. событий", "Kafka")

' === ПРОВЕРКА ПРАВ ДОСТУПА ===
Rel(4, 1, "<b>4→1</b> Проверка прав", "Token")
Rel(5, 1, "<b>5→1</b> RLS валидация", "Token")
Rel(9, 1, "<b>9→1</b> Фильтрация datasets", "Token")
@enduml